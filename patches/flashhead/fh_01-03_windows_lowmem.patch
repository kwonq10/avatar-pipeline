diff --git a/flash_head/utils/lowmem_load.py b/flash_head/utils/lowmem_load.py
new file mode 100644
index 0000000..c2694d4
--- /dev/null
+++ b/flash_head/utils/lowmem_load.py
@@ -0,0 +1,39 @@
+# [Avatar-Pipeline patch FH-03] diffusers のモデルを、CPU にモデル全体を作らずに GPU へ読み込む。
+#   1. accelerate.init_empty_weights でパラメータだけ meta にして作る（self.freqs のような普通のテンソルは通常どおり作られる）
+#   2. safetensors のヘッダーを直接読み、テンソルを1個ずつファイルから読んで、すぐ device / dtype に変換する
+#      （CPU 上にあるのは常に1テンソル分。最大は audio_proj.proj1_vf.weight の 151MB）
+#   3. load_state_dict(strict=True, assign=True) で GPU 上のテンソルをそのままパラメータにする
+import json, os, struct
+import torch
+from accelerate import init_empty_weights
+
+_DT = {"F32": torch.float32, "F16": torch.float16, "BF16": torch.bfloat16, "I64": torch.int64, "I32": torch.int32}
+
+def _read_header(path):
+    with open(path, "rb") as f:
+        n = struct.unpack("<Q", f.read(8))[0]
+        hdr = json.loads(f.read(n))
+    hdr.pop("__metadata__", None)
+    return hdr, 8 + n
+
+def load_model_lowmem(cls, model_dir, device, dtype):
+    config = cls.load_config(model_dir)
+    with init_empty_weights():
+        model = cls.from_config(config)
+    path = os.path.join(model_dir, "diffusion_pytorch_model.safetensors")
+    hdr, base = _read_header(path)
+    sd = {}
+    with open(path, "rb") as f:
+        for k, h in sorted(hdr.items(), key=lambda kv: kv[1]["data_offsets"][0]):
+            b, e = h["data_offsets"]
+            f.seek(base + b)
+            buf = bytearray(f.read(e - b))
+            t = torch.frombuffer(buf, dtype=_DT[h["dtype"]]).reshape(h["shape"]) if e > b else torch.empty(h["shape"], dtype=_DT[h["dtype"]])
+            sd[k] = t.to(device=device, dtype=dtype if t.is_floating_point() else t.dtype)
+            del t, buf
+    model.load_state_dict(sd, strict=True, assign=True)
+    del sd
+    left = [n for n, p in list(model.named_parameters()) + list(model.named_buffers()) if p.device.type == "meta"]
+    if left:
+        raise RuntimeError(f"meta のまま残った: {left[:5]}")
+    return model
